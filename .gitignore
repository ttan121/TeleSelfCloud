# Chỉ cho phép mã nguồn, cấu hình build và tài liệu phân phối cần thiết.
/*
!/.gitignore
!/README.md
!/TeleSelfCloud.slnx
!/nuget.config
!/src/
!/tests/
!/scripts/
!/docs/
!/licenses/

/src/**
