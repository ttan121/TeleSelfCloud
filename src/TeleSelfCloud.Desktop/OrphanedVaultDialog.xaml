<Window x:Class="TeleSelfCloud.Desktop.OrphanedVaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Rescue Options" Height="350" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="The Telegram storage channel for this account could not be found. It may have been deleted." TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <TextBlock Text="What would you like to do?" Margin="0,0,0,10"/>
        
        <RadioButton x:Name="RadioWipe" Content="Wipe Local Index (Start fresh)" IsChecked="True" Margin="0,0,0,5"/>
        <TextBlock Text="Deletes local database and cache. All tracking of the lost vault is removed." FontSize="11" Foreground="Gray" Margin="20,0,0,15" TextWrapping="Wrap"/>
        
        <RadioButton x:Name="RadioReupload" Content="Re-upload remaining local cache" Margin="0,0,0,5"/>
        <TextBlock Text="Creates a new vault and uploads any files that still have parts in the local cache." FontSize="11" Foreground="Gray" Margin="20,0,0,15" TextWrapping="Wrap"/>

        <RadioButton x:Name="RadioRelink" Content="Relink file IDs (Forwarded messages)" Margin="0,0,0,5"/>
        <TextBlock Text="Connect to a new vault where you have forwarded the previous messages." FontSize="11" Foreground="Gray" Margin="20,0,0,20" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Execute" Width="80" Click="Execute_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
