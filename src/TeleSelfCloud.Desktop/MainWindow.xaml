                    <TextBlock Grid.Row="2" Text="{local:UiTextExtension Key=appLock.passphrase}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="AppLockUnlockPasswordBox" Grid.Row="3" MinHeight="46" MaxLength="256" Padding="8,6" AutomationProperties.Name="{local:UiTextExtension Key=appLock.passphrase}" KeyDown="AppLockUnlockPasswordBox_KeyDown"/>
                    <TextBlock x:Name="AppLockUnlockErrorText" Grid.Row="4" Foreground="{DynamicResource ErrorRed}" TextWrapping="Wrap" Margin="0,10,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock x:Name="AppLockRecoveryText" Grid.Row="5" Text="{local:UiTextExtension Key=appLock.recovery}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,16" Visibility="Collapsed"/>
                    <WrapPanel Grid.Row="6" HorizontalAlignment="Right">
                        <Button Content="{local:UiTextExtension Key=appLock.closeApp}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="AppLockClose_Click"/>
                        <Button x:Name="AppLockUnlockButton" Content="{local:UiTextExtension Key=appLock.unlock}" Style="{StaticResource PrimaryButton}" Click="AppLockUnlock_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>















