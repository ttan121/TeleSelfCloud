<Window x:Class="TeleSelfCloud.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeleSelfCloud.Desktop"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="d"
        Title="{local:UiTextExtension Key=app.title}" Height="760" Width="1000"
        MinHeight="650" MinWidth="760" Background="{DynamicResource ContentBg}"
        FontFamily="Segoe UI Variable, Segoe UI, Arial" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#F3F3FA" po:Freeze="False"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#E8E7EE" po:Freeze="False"/>
        <SolidColorBrush x:Key="ContentBg" Color="#F9F9FF" po:Freeze="False"/>
        <SolidColorBrush x:Key="ContentBorder" Color="#80838F" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1B20" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#44464F" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666873" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextOnDark" Color="#001945" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextOnDarkMuted" Color="#44464F" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1558C0" po:Freeze="False"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" po:Freeze="False"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#BA1A1A" po:Freeze="False"/>
        <SolidColorBrush x:Key="SurfaceContainer" Color="#FFFFFF" po:Freeze="False"/>
        <SolidColorBrush x:Key="SelectionBackground" Color="#D9E2FF" po:Freeze="False"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#E1E2EC" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentHover" Color="#12478F" po:Freeze="False"/>
        <SolidColorBrush x:Key="AvatarBackground" Color="#E8E7EE" po:Freeze="False"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#FFDAD6" po:Freeze="False"/>
        <SolidColorBrush x:Key="ModalBackdrop" Color="#661A1B20" po:Freeze="False"/>
        <local:ExplorerCompactConverter x:Key="ExplorerCompact"/>
        <DataTemplate x:Key="ExplorerDetailsTemplate">
            <Border CornerRadius="6" BorderBrush="{DynamicResource ContentBorder}" BorderThickness="1" Padding="12,8" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NameColumn" Width="*"/>
                        <ColumnDefinition x:Name="SizeColumn" Width="80"/>
                        <ColumnDefinition x:Name="DateColumn" Width="120"/>
                        <ColumnDefinition x:Name="StatusColumn" Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NameCell">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                        <TextBlock Text="{Binding EncryptionLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <TextBlock x:Name="SizeCell" Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <TextBlock x:Name="DateCell" Grid.Column="2" Text="{Binding FormattedDate}" ToolTip="{Binding FormattedDate}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusCell" Grid.Column="3" Text="{Binding StatusLabel}" ToolTip="{Binding StatusLabel}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource ExplorerCompact}}" Value="True">
                    <Setter TargetName="NameColumn" Property="Width" Value="70"/>
                    <Setter TargetName="SizeColumn" Property="Width" Value="120"/>
                    <Setter TargetName="DateColumn" Property="Width" Value="*"/>
                    <Setter TargetName="StatusColumn" Property="Width" Value="0"/>
                    <Setter TargetName="NameCell" Property="Grid.ColumnSpan" Value="4"/>
                    <Setter TargetName="SizeCell" Property="Grid.Row" Value="1"/><Setter TargetName="SizeCell" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="DateCell" Property="Grid.Row" Value="1"/><Setter TargetName="DateCell" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="StatusCell" Property="Grid.Row" Value="1"/><Setter TargetName="StatusCell" Property="Grid.Column" Value="2"/>
                    <Setter TargetName="SizeCell" Property="Margin" Value="0,6,8,0"/>
                    <Setter TargetName="DateCell" Property="Margin" Value="0,6,8,0"/>
                    <Setter TargetName="StatusCell" Property="Margin" Value="0,6,0,0"/>
                    <Setter TargetName="SizeCell" Property="FontSize" Value="11"/>
                    <Setter TargetName="DateCell" Property="FontSize" Value="11"/>
                    <Setter TargetName="StatusCell" Property="FontSize" Value="11"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ExplorerDetailsPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerIconPanel"><local:VirtualizingTilePanel/></ItemsPanelTemplate>
        <DataTemplate x:Key="ExplorerIconTemplate">
            <Border CornerRadius="6" BorderBrush="{DynamicResource ContentBorder}" BorderThickness="1" Padding="8" Margin="4" ToolTip="{Binding DisplayName}">
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Margin="0,0,0,8"/>
                    <Grid Height="126" ClipToBounds="True" Background="{DynamicResource ContentBg}">
                        <Path Data="M4,2 L17,2 L24,9 L24,30 L4,30 Z M17,2 L17,9 L24,9 M8,16 L20,16 M8,21 L20,21" Stroke="{DynamicResource AccentBlue}" StrokeThickness="1.5" Stretch="Uniform" Width="32" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <local:ExplorerThumbnail Manifest="{Binding Manifest}" Stretch="UniformToFill" AutomationProperties.Name="{Binding FileName}"/>
                    </Grid>
                    <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLabel}" FontSize="11"/>
                    <TextBlock Text="{Binding EncryptionLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ExplorerViewButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ViewBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SidebarHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ViewBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/><Setter TargetName="ViewBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VaultChoiceStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayLabel}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusLabel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SidebarHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VaultPickerStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VaultChoiceStyle}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="PickerBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ContentBorder}" BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,6,26,6" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EmptyChoice" Text="{local:UiTextExtension Key=vault.noChoices}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="8,6,26,6" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource SurfaceContainer}" BorderBrush="{DynamicResource ContentBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="320">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="EmptyChoice" Property="Visibility" Value="Visible"/><Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerBorder" Property="Background" Value="{DynamicResource SidebarHover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PickerBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/><Setter TargetName="PickerBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="WrappedHelpToolTip" TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="394" LineHeight="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="GroupName" Value="MainNav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="64" Height="56" Background="Transparent">
                            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{DynamicResource AccentBlue}" Opacity="0"/>
                            <Border x:Name="BgFill" Margin="6,4" CornerRadius="8" Background="Transparent"/>
                            <Border x:Name="KeyboardFocusBorder" Margin="2" CornerRadius="10" BorderBrush="Transparent" BorderThickness="0" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" Content="{TemplateBinding Tag}" Width="20" Height="20"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgFill" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnDark}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgFill" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="KeyboardFocusBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextMuted}" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceContainer}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1B20"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1A1B20"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorder}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Fill="{DynamicResource AccentBlue}" Stretch="Uniform" Width="24" Height="24" Data="M12 2 L20 6 L20 13 Q20 19 12 22 Q4 19 4 13 L4 6 Z"/>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton x:Name="NavFiles" Style="{StaticResource NavButton}" Content="{local:UiTextExtension Key=nav.files}" IsChecked="True" Click="NavFiles_Click" AutomationProperties.HelpText="{local:UiTextExtension Key=shortcut.files}">
                        <RadioButton.Tag>
                            <Path Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M3 7Q3 5 5 5H11L13 8H19Q21 8 21 10V18Q21 20 19 20H5Q3 20 3 18Z"/>
                        </RadioButton.Tag>
