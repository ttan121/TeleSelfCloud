                            <ComboBoxItem Content="{local:UiTextExtension Key=filter.allParts}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=filter.someParts}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=filter.noParts}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=filter.verified}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=filter.notVerified}"/>
                        </ComboBox>
                        <ComboBox x:Name="TypeFilterBox" Width="140" Height="32" Margin="0,0,12,8" SelectionChanged="TypeFilterBox_SelectionChanged" AutomationProperties.Name="{local:UiTextExtension Key=files.type}">
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.all}" IsSelected="True"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.images}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.video}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.audio}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.documents}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.archives}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.code}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.type.other}"/>
                        </ComboBox>
                        <ComboBox x:Name="FilesScopeBox" Width="130" Height="32" Margin="0,0,12,8" SelectionChanged="FilesScopeBox_SelectionChanged" AutomationProperties.Name="{local:UiTextExtension Key=files.scope}">
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.scope.all}" IsSelected="True"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.scope.favorites}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.scope.archive}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=files.scope.hidden}"/>
                        </ComboBox>
                        <WrapPanel x:Name="TopActions" MaxWidth="{Binding ActualWidth, ElementName=FilesTopControls}" Margin="0,0,0,8">
