                        <TextBlock x:Name="FilesEmptyText" Text="{local:UiTextExtension Key=files.empty}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                    </StackPanel>
                    <Border x:Name="FilesDropOverlay" Grid.Row="2" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource SurfaceContainer}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="2" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{local:UiTextExtension Key=files.dropHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MaxWidth="420"/>
                    </Border>
                    <Border Grid.Row="3" x:Name="FileDetailPanel" Background="{DynamicResource SurfaceContainer}" BorderBrush="{DynamicResource ContentBorder}" BorderThickness="0,1,0,0" Padding="20,12" Visibility="Collapsed">
