                                <Button x:Name="PreviewButton" Content="{local:UiTextExtension Key=action.preview}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="PreviewFile_Click"/>
                                <Button x:Name="RestoreLocalButton" Content="{local:UiTextExtension Key=action.restoreLocal}" ToolTip="{local:UiTextExtension Key=action.restoreLocalTip}" AutomationProperties.Name="{local:UiTextExtension Key=action.restoreLocal}" AutomationProperties.HelpText="{local:UiTextExtension Key=action.restoreLocalTip}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Restore_Click"/>
                                <Button x:Name="DownloadButton" Content="{local:UiTextExtension Key=action.download}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="DownloadFile_Click"/>
                                <Button x:Name="RenameButton" Content="{local:UiTextExtension Key=action.rename}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="RenameFile_Click"/>
                                <Button x:Name="MoveButton" Content="{local:UiTextExtension Key=action.move}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="MoveFile_Click"/>
