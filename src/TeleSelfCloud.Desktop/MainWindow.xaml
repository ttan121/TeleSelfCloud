                            <Button x:Name="UploadButton" Content="{local:UiTextExtension Key=upload.choose}" AutomationProperties.Name="{local:UiTextExtension Key=upload.choose}" Style="{StaticResource PrimaryButton}" Click="UploadButton_Click" IsEnabled="False">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="{local:UiTextExtension Key=upload.chooseFiles}" AutomationProperties.Name="{local:UiTextExtension Key=upload.chooseFiles}" Click="ChooseFile_Click"/>
                                        <MenuItem Header="{local:UiTextExtension Key=upload.chooseFolder}" AutomationProperties.Name="{local:UiTextExtension Key=upload.chooseFolder}" Click="UploadFolderButton_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="FilesPage" AllowDrop="True" DragEnter="FilesPage_DragEnter" DragOver="FilesPage_DragOver" DragLeave="FilesPage_DragLeave" Drop="FilesPage_Drop" AutomationProperties.HelpText="{local:UiTextExtension Key=files.dropHint}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
