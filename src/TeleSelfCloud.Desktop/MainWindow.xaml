                                <Button x:Name="CloseUploadSelectionButton" Content="{local:UiTextExtension Key=upload.closeSelection}" ToolTip="{local:UiTextExtension Key=upload.closeSelectionTip}" AutomationProperties.Name="{local:UiTextExtension Key=upload.closeSelection}" AutomationProperties.HelpText="{local:UiTextExtension Key=upload.closeSelectionTip}" Style="{StaticResource GhostButton}" Margin="8,0,0,8" Click="CloseUploadSelection_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{local:UiTextExtension Key=upload.dedupTip}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="ManifestList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ToolTip="{local:UiTextExtension Key=selection.tip}" AutomationProperties.HelpText="{local:UiTextExtension Key=selection.tip}" Background="Transparent" BorderThickness="0" Margin="16" SelectionChanged="ManifestList_SelectionChanged" MouseDoubleClick="ManifestList_MouseDoubleClick" AutomationProperties.Name="{local:UiTextExtension Key=files.filesList}">
