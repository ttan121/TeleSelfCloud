                            <Button x:Name="ResumeFolderChangeButton" Content="{local:UiTextExtension Key=folder.resume}" ToolTip="{local:UiTextExtension Key=folder.resumeTip}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="ResumeFolderChange_Click"/>
