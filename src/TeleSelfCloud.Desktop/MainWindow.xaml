                            <ComboBoxItem Content="{local:UiTextExtension Key=sort.smallest}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=sort.newest}"/>
                            <ComboBoxItem Content="{local:UiTextExtension Key=sort.oldest}"/>
                        </ComboBox>
