<UserControl x:Class="TeleSelfCloud.Desktop.MetadataVersionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TeleSelfCloud.Desktop">
    <Grid MaxHeight="280">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,12,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{local:UiTextExtension Key=metadata.versions}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{local:UiTextExtension Key=metadata.explanation}" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="CurrentSummary" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="VersionsList" Grid.Row="1" Margin="0,8,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{local:UiTextExtension Key=metadata.versions}" SelectionChanged="VersionsList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Organization}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Revision}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="HistoryStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
    </ScrollViewer>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="ApplyVersionButton" Content="{local:UiTextExtension Key=metadata.apply}" Style="{DynamicResource PrimaryButton}"
                    AutomationProperties.Name="{local:UiTextExtension Key=metadata.apply}" IsEnabled="False" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button x:Name="PrepareVersionButton" Content="{local:UiTextExtension Key=metadata.prepare}" Style="{DynamicResource GhostButton}"
                    AutomationProperties.Name="{local:UiTextExtension Key=metadata.prepare}" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0" Click="Prepare_Click"/>
            <Button Content="{local:UiTextExtension Key=metadata.close}" Style="{DynamicResource GhostButton}" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
