<UserControl x:Class="TeleSelfCloud.Desktop.FolderRecoveryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TeleSelfCloud.Desktop">
    <Grid MaxHeight="280">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{local:UiTextExtension Key=folder.review.title}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="PlanSummary" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{local:UiTextExtension Key=folder.review.explanation}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                <ListBox x:Name="RecoveryFiles" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{local:UiTextExtension Key=folder.review.files}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding State}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Location}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="RetryPlanButton" Content="{local:UiTextExtension Key=folder.resume}" Style="{DynamicResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0" Click="Retry_Click"/>
            <Button x:Name="KeepStateButton" Content="{local:UiTextExtension Key=folder.stop.action}" AutomationProperties.Name="{local:UiTextExtension Key=folder.stop.action}" Style="{DynamicResource GhostButton}" IsEnabled="False" Margin="0,0,8,0" Click="Keep_Click"/>
            <Button Content="{local:UiTextExtension Key=folder.review.close}" Style="{DynamicResource GhostButton}" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
